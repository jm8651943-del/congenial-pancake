# Jobber OAuth configuration — never commit real secrets.
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REDIRECT_URI=https://YOUR-VERCEL-DOMAIN.vercel.app/api/jobber/callback
JOBBER_GRAPHQL_VERSION=2025-04-16
# Long random secret used only to encrypt the temporary OAuth state and session cookie.
JOBBER_SESSION_SECRET=
# Required only when the browser UI is hosted on a different origin (for example localhost).
OPTIMIZE_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
# Use None for cross-origin local UI calls; keep Lax when the UI is served from the same Vercel origin.
JOBBER_COOKIE_SAMESITE=Lax
JOBBER_COOKIE_SECURE=true
