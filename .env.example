# Jobber OAuth configuration — never commit real secrets.
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REDIRECT_URI=https://YOUR-VERCEL-DOMAIN.vercel.app/api/jobber/callback
# Configure scopes in the Jobber Developer Center; keep this value aligned with the scopes your app actually needs.
JOBBER_SCOPES=
JOBBER_GRAPHQL_VERSION=2025-04-16
# Long random secret used only to encrypt the temporary OAuth state and session cookie.
JOBBER_SESSION_SECRET=
