# OPTIMIZE application infrastructure
DATABASE_URL=
OPTIMIZE_ENCRYPTION_SECRET=
OPTIMIZE_COOKIE_SAMESITE=Lax
OPTIMIZE_COOKIE_SECURE=

# Jobber OAuth 2.0
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REDIRECT_URI=https://YOUR-VERCEL-DOMAIN.vercel.app/api/jobber/callback
JOBBER_GRAPHQL_VERSION=2025-04-16

# CORS only when a browser UI is hosted on a different origin.
OPTIMIZE_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765

# Local cross-origin browser testing:
# OPTIMIZE_COOKIE_SAMESITE=None
# OPTIMIZE_COOKIE_SECURE=true
